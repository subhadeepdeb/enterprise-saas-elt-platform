ENVIRONMENT=dev
LANDING_ROOT=data/landing
QUARANTINE_ROOT=data/quarantine
APP_API_BASE_URL=
APP_API_TOKEN=
S3_BUCKET=
S3_PREFIX=saas-elt/raw
AWS_DEFAULT_REGION=us-east-1

# Snowflake values are read by profiles.yml.example and the loader.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=SAAS_ELT_TRANSFORMER
SNOWFLAKE_WAREHOUSE=SAAS_ELT_TRANSFORM_WH
SNOWFLAKE_DATABASE=SAAS_ANALYTICS
SNOWFLAKE_SCHEMA=RAW

# Optional alerting destination.
ALERT_WEBHOOK_URL=

